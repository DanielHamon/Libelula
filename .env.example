# Supabase — obtener en: supabase.com > tu proyecto > Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave PÚBLICA del widget Cloudflare Turnstile (modo Managed).
VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY se configura solo en secretos de Supabase Edge.
# Nunca usar prefijo VITE_ para la clave secreta de Turnstile.

# Solo para scripts administrativos locales. Nunca usar SUPABASE_SERVICE_ROLE_KEY
# en variables VITE_ ni dentro del frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Copiar este archivo como .env.local y rellenar con tus valores reales
